# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude override files as they are usually local
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files because they shouldn’t be committed
*.tfplan

# CLI config files
.terraformrc
terraform.rc

# Lock file (optional: keep in repo if you want consistent provider versions)
.terraform.lock.hcl
